# LOCAL development: copy this file to .env or use npm run setup.
# Never commit .env. The Render Dashboard holds production settings.
APP_URL=http://localhost:3000
DATA_DIR=.data
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Studio Owner"
# Optional: PORT=3000

# Render Free:
# - Do not configure DATA_DIR under /var/data.
# - The Free filesystem is ephemeral, so SQLite data and uploaded media
#   can be lost after redeploys, restarts, or idle spin-downs.
# - The app can boot without a persistent disk using DATA_DIR=.data.
# - APP_URL can be omitted on Render: RENDER_EXTERNAL_URL is used automatically.
# Set APP_URL=https://your-custom-domain.example when using a custom domain.

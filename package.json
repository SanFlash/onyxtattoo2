{
  "name": "onyx-tattoo-studio-render",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "admin:reset": "node --env-file-if-exists=.env scripts/reset-admin.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/validation.test.mjs tests/storage.test.mjs",
    "test:e2e": "node tests/render-smoke.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/italiana": "5.3.0",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
